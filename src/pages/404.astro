---
import Layout from "../layouts/Layout.astro";
---

<Layout title="404 | Página no encontrada">
    <main class="min-h-screen flex items-center justify-center px-6  from-slate-950 via-slate-900 to-slate-950 text-white">
        <div class="text-center max-w-md">
            <h1 class="text-8xl font-bold tracking-tight bg-gradient-to-r from-indigo-400 via-purple-400 to-pink-400 bg-clip-text text-transparent">
                404
            </h1>

            <!-- título -->
            <h2 class="mt-6 text-2xl font-semibold text-white">
                Página no encontrada
            </h2>

            <!-- descripción -->
            <p class="mt-3 text-slate-400 leading-relaxed">
                La ruta que estás buscando no existe o fue movida.
            </p>

            <div id="card-404" class="mt-8 rounded-2xl border border-white/10 backdrop-blur-md p-6 shadow-xl">
                <p class="text-sm text-slate-300">
                Puedes volver al inicio o explorar otros contenidos del blog.
                </p>

                <!-- botones -->
                <div class="mt-6 flex flex-col sm:flex-row gap-3 justify-center">

                    <a href="/" 
                        id="btn-volver-404" class="px-5 py-2 rounded-lg  text-slate-900 font-medium transition">
                        Volver al inicio
                    </a>

                    <a href="/blog"
                        id="btn-ver-blog-404" class="px-5 py-2 rounded-lg border border-white/15 text-white hover:bg-white/10 transition">
                        Ver blog
                    </a>
                </div>

                <!-- detalle visual -->
                <p class="detalle">
                    Error 404 · DevFundamentals
                </p>
            </div>
        </div>
    </main>
</Layout>

<style>
    #card-404{
        background: var(--bg-glow);
    }

    #btn-volver-404{
        background: var(--bg-morado);
        color: var(--text-primary);
        font-weight: 500;
    }

    #btn-volver-404:hover{
        background-color: var(--accent-color);
        cursor: pointer;
        box-shadow: 0 4px 14px 0 var(--accent-light);
    }

    #btn-ver-blog-404:hover{
        background: var(--accent-color);
        cursor: pointer;
    }

    .detalle{
        font-size: 12px;
        padding: 15px;
        color: var(--text-muted);
        font-weight: 400;
    }

</style>