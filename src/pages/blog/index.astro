---
// Layout y componentes
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';

// API oficial de Astro Content Collections
import { getCollection } from 'astro:content';

// Obtiene los posts publicados y los ordena del más reciente al más antiguo
const posts = (await getCollection('blog'))
    .filter((post) => !post.data.draft)
    .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

// Obtiene tags únicas
const allTags = [...new Set(posts.flatMap((post) => post.data.tags))].sort();
---

<BaseLayout title="DevFundamentals | Blog" description="Todos los artículos y tutoriales.">

    <div class="blog-header">
        <p class="eyebrow">escritura & código</p>
        <h1>Nuestro <span class="text-gradient">Blog</span></h1>
        <p class="subtitle">Últimos artículos, tutoriales y novedades sobre desarrollo y más.</p>
    </div>

    <div class="toolbar">
        <span class="post-count">
            <strong>{posts.length}</strong> artículos publicados
        </span>
    </div>

    <div class="posts-grid">
        {posts.map((post) => <PostCard post={post} />)}
    </div>

</BaseLayout>

<style>
    /* ── Header ── */
    .blog-header {
        text-align: center;
        padding: 3rem 1rem 3.5rem;
        position: relative;
        animation: fadeUp 0.6s ease-out;
    }

    /* línea decorativa debajo del header */
    .blog-header::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 50%;
        transform: translateX(-50%);
        width: 60px;
        height: 2px;
        background: linear-gradient(90deg, var(--accent-color), var(--teal-color));
        border-radius: 2px;
    }

    /* pequeño texto encima del título */
    .eyebrow {
        font-size: 0.72rem;
        font-weight: 600;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--accent-light);
        margin-bottom: 1rem;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
    }

    .eyebrow::before,
    .eyebrow::after {
        content: '';
        width: 24px;
        height: 1px;
        background: var(--accent-color);
        opacity: 0.5;
    }

    h1 {
        font-size: clamp(2.2rem, 5vw, 3.2rem);
        font-weight: 700;
        line-height: 1.1;
        letter-spacing: -0.02em;
    }

    .text-gradient {
        background: linear-gradient(
            120deg,
            var(--accent-color) 0%,
            var(--accent-light) 50%,
            var(--teal-color) 100%
        );
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .subtitle {
        color: var(--text-secondary);
        font-size: 1.05rem;
        margin-top: 1rem;
        max-width: 460px;
        margin-inline: auto;
        line-height: 1.6;
    }

    /* ── Toolbar ── */
    .toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1.75rem 0 1.25rem;
        flex-wrap: wrap;
        gap: 0.75rem;
    }

    .post-count {
        font-size: 0.8rem;
        color: var(--text-muted);
    }

    .post-count strong {
        color: var(--text-secondary);
    }

    /* ── Grid ── */
    .posts-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 1.5rem;
    }

    @keyframes fadeUp {
        from { opacity: 0; transform: translateY(16px); }
        to   { opacity: 1; transform: translateY(0); }
    }
</style>