---
import type { CollectionEntry } from "astro:content";

interface Props {
    // se encarga de mostrar los 3 posts más recientes, ordenados por fecha de publicación
    posts: CollectionEntry<'blog'>[];
}

const {posts} = Astro.props

const tagColors: Record<string, string> = {
    docker:    "#0ea5e9",
    linux:     "#22c55e",
    web:       "#a855f7",
    devops:    "#ec4899",
    databases: "#f59e0b",
};
---

<section class="recent-section">
    <div class="section-header">
        <p class="section-label">Artículos recientes</p>
        <h2>Lo más nuevo</h2>
    </div>

    <div class="post-list">
        {posts.map((post) =>{
            const tag = post.data.tags?.[0] ?? "";
            const color = tagColors[tag] ?? "#a855f7";
            const date = post.data.pubDate.toLocaleDateString("es-ES", {
                day: "numeric", month: "short", year: "numeric"
            });

            return(
                <a href={`/blog/${post.id}`} class="post-item">
                <div class="post-left">
                    <span
                    class="post-tag"
                    style={`background: ${color}15; color: ${color}; border-color: ${color}30`}
                    >
                    #{tag}
                    </span>
                    <h3 class="post-title">{post.data.title}</h3>
                    <p class="post-desc">{post.data.description}</p>
                    <time class="post-date">{date}</time>
                </div>
                <span class="post-arrow">→</span>
                </a>               
            );
        })}
    </div>

    <div class="see-all">
        <a href="/blog">Ver todos los artículos →</a>
    </div>
</section>

<style>
    .recent-section {
        padding: 3.5rem 1rem;
        max-width: 900px;
        margin: 0 auto;
        border-top: 1px solid var(--border-color);
    }

    .section-header {
        margin-bottom: 1.5rem;
    }
    .section-label {
        font-size: 0.75rem;
        font-weight: 700;
        color: var(--accent-color);
        text-transform: uppercase;
        letter-spacing: 0.1em;
        margin-bottom: 0.4rem;
    }
    .section-header h2 {
        font-size: 1.75rem;
        font-weight: 600;
        color: var(--text-primary);
    }

    .posts-list {
        display: flex;
        flex-direction: column;
        gap: 0;
    }

    .post-item {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1.25rem 0;
        border-bottom: 1px solid var(--border-color);
        text-decoration: none;
        transition: background 0.15s;
        border-radius: 4px;
        margin: 0 -0.75rem;
        padding-left: 0.75rem;
        padding-right: 0.75rem;
    }
    .post-item:hover {
        background: var(--surface-color);
    }
    .post-item:hover .post-arrow {
        opacity: 1;
        transform: translateX(3px);
    }

    .post-left { flex: 1; min-width: 0; }

    .post-tag {
        display: inline-block;
        font-size: 0.72rem;
        font-weight: 500;
        padding: 2px 10px;
        border-radius: 999px;
        border: 1px solid transparent;
        margin-bottom: 6px;
    }

    .post-title {
        font-size: 1rem;
        font-weight: 500;
        color: var(--text-primary);
        margin-bottom: 4px;
        line-height: 1.4;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .post-desc {
        font-size: 0.85rem;
        color: var(--text-secondary);
        line-height: 1.5;
        margin-bottom: 6px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .post-date {
        font-size: 0.75rem;
        color: var(--text-muted);
    }

    .post-arrow {
        font-size: 1rem;
        color: var(--text-muted);
        opacity: 0;
        transition: opacity 0.15s, transform 0.15s;
        flex-shrink: 0;
    }

    .see-all {
        margin-top: 1.5rem;
        text-align: center;
    }
    .see-all a {
        font-size: 0.9rem;
        color: var(--accent-color);
        text-decoration: none;
        font-weight: 500;
        transition: color 0.15s;
    }
    .see-all a:hover { color: var(--accent-light); }

    @media (max-width: 600px) {
        .post-title { white-space: normal; }
    }

</style>
