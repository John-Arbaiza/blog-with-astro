---
import '../styles/global.css'
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

export interface Props {
    title: string;
}

const { title } = Astro.props;
---
<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <title>{title}</title>
    </head>
    <body>
		<Header />
        <main class="container">
            <slot />
        </main>
        <div class="absolute inset-0 overflow-hidden pointer-events-none">
            <div class="absolute -top-40 -left-40 w-96 h-96 bg-purple-600 rounded-full blur-3xl opacity-30"></div>
            <div class="absolute top-40 right-0 w-96 h-96 bg-blue-600 rounded-full blur-3xl opacity-30"></div>
        </div>
        <Footer/>
    </body>
</html>

<style>
	main {
		flex: 1;
		padding: 4rem 0;
	}

	.container {
		max-width: 900px;
		margin: 0 auto;
		padding: 0 2rem;
	}
</style>
