---
import BaseLayout from "./BaseLayout.astro";
import type { CollectionEntry } from "astro:content";

interface Props {
    post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { title, description, pubDate, updatedDate, author, tags } = post.data;

const formattedPubDate = pubDate.toLocaleDateString("es-ES", {
    year: "numeric",
    month: "long",
    day: "numeric",
});
---

<BaseLayout title={title} description={description}>
    <div class="page-wrapper">

        <!-- BACKGROUND EFFECTS -->
        <div class="ambient-glow"></div>
        <div class="ambient-glow-secondary"></div>
        <div class="noise-overlay"></div>

        <!-- Sidebar Table of Contents -->
        <aside class="toc-sidebar" id="toc-sidebar">
            <div class="toc-inner">
                <p class="toc-label">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <line x1="3" y1="6" x2="21" y2="6"/>
                        <line x1="3" y1="12" x2="16" y2="12"/>
                        <line x1="3" y1="18" x2="11" y2="18"/>
                    </svg>
                    Contenido
                </p>
                <nav id="toc-nav"></nav>
            </div>
        </aside>

        <!-- Main Article -->
        <article class="post-container">

            <header class="post-header">
                <div class="tags">
                    {tags.map((tag) => (
                        <a href={`/blog/etiqueta/${tag}`} class="tag">{tag}</a>
                    ))}
                </div>

                <h1 class="post-title">{title}</h1>
                <p class="post-description">{description}</p>

                <div class="meta">
                    <span class="meta-author">
                        <span class="meta-icon-wrap">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>
                        </span>
                        {author}
                    </span>
                    <span class="meta-dot"></span>
                    <time datetime={pubDate.toISOString()} class="meta-date">
                        <span class="meta-icon-wrap">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
                        </span>
                        {formattedPubDate}
                    </time>
                    {updatedDate && (
                        <>
                            <span class="meta-dot"></span>
                            <span class="meta-updated">
                                <span class="meta-icon-wrap">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 4v6h6"/><path d="M3.51 15a9 9 0 1 0 .49-4"/></svg>
                                </span>
                                Actualizado {updatedDate.toLocaleDateString('es-ES')}
                            </span>
                        </>
                    )}
                </div>
            </header>

            <div class="divider"></div>

            <div class="prose" id="prose-content">
                <slot />
            </div>

            <!-- Back to top -->
            <div class="back-to-top-wrap">
                <button class="back-to-top" id="back-to-top" aria-label="Volver arriba">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 19V5M5 12l7-7 7 7"/></svg>
                    Volver arriba
                </button>
            </div>

        </article>
    </div>
</BaseLayout>

<script>
    function buildToc() {
        const prose   = document.getElementById('prose-content');
        const nav     = document.getElementById('toc-nav');
        const sidebar = document.getElementById('toc-sidebar');
        if (!prose || !nav || !sidebar) return;

        const headings = Array.from(prose.querySelectorAll('h2, h3'));
        if (headings.length === 0) { sidebar.style.display = 'none'; return; }

        headings.forEach((h, i) => { if (!h.id) h.id = `seccion-${i}`; });

        const ul = document.createElement('ul');
        headings.forEach((h) => {
            const li = document.createElement('li');
            li.dataset.level = h.tagName.toLowerCase();

            const a = document.createElement('a');
            a.href = `#${h.id}`;
            a.textContent = h.textContent ?? '';
            a.dataset.id  = h.id;
            a.addEventListener('click', (e) => {
                e.preventDefault();
                document.getElementById(h.id)?.scrollIntoView({ behavior: 'smooth' });
            });

            li.appendChild(a);
            ul.appendChild(li);
        });
        nav.appendChild(ul);

        const links = nav.querySelectorAll('a');
        const observer = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting) {
                        links.forEach((l) => l.classList.remove('active'));
                        nav.querySelector(`a[data-id="${entry.target.id}"]`)?.classList.add('active');
                    }
                });
            },
            { rootMargin: '-15% 0px -75% 0px' }
        );
        headings.forEach((h) => observer.observe(h));
    }

    // Back to top
    function initBackToTop() {
        const btn = document.getElementById('back-to-top');
        if (!btn) return;
        btn.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
    }

    // Reading progress bar
    function initProgress() {
        const bar = document.getElementById('reading-progress');
        if (!bar) return;
        window.addEventListener('scroll', () => {
            const scrollTop = window.scrollY;
            const docHeight = document.documentElement.scrollHeight - window.innerHeight;
            const progress = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
            bar.style.width = `${progress}%`;
        }, { passive: true });
    }

    document.addEventListener('DOMContentLoaded', () => {
        buildToc();
        initBackToTop();
        initProgress();
    });
</script>

    <style is:global>
    /* ── Reading progress bar (injected at top of page) ── */
    #reading-progress {
        position: fixed;
        top: 0;
        left: 0;
        height: 2px;
        width: 0%;
        background: linear-gradient(to right, var(--accent-color), var(--teal-color));
        z-index: 1000;
        transition: width 0.1s linear;
        border-radius: 0 2px 2px 0;
    }

    /* ── Prose styles ── */
    .prose h2 {
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--text-primary);
        margin: 2.5rem 0 1rem;
        letter-spacing: -0.02em;
        position: relative;
        padding-left: 1rem;
    }

    .prose h2::before {
        content: '';
        position: absolute;
        left: 0;
        top: 0.2em;
        height: 1.1em;
        width: 3px;
        background: var(--accent-color);
        border-radius: 2px;
        box-shadow: 0 0 12px var(--accent-glow);
    }

    .prose h3 {
        font-size: 1.15rem;
        font-weight: 600;
        color: var(--text-primary);
        margin: 2rem 0 0.75rem;
        letter-spacing: -0.01em;
    }

    .prose p {
        color: var(--text-secondary);
        line-height: 1.85;
        margin-bottom: 1.25rem;
        font-size: 1.025rem;
    }

    .prose a {
        color: var(--accent-light);
        text-decoration: none;
        border-bottom: 1px solid rgba(192, 132, 252, 0.3);
        transition: color 0.2s, border-color 0.2s;
    }

    .prose a:hover {
        color: #dda0ff;
        border-color: rgba(192, 132, 252, 0.7);
    }

    .prose strong {
        color: var(--text-primary);
        font-weight: 600;
    }

    .prose code {
        font-family: var(--font-mono);
        font-size: 0.875em;
        background: rgba(168, 85, 247, 0.1);
        border: 1px solid rgba(168, 85, 247, 0.2);
        color: var(--accent-light);
        padding: 0.15em 0.45em;
        border-radius: 5px;
    }

    .prose pre {
        background: var(--surface-color);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        padding: 1.25rem 1.5rem;
        overflow-x: auto;
        margin: 1.5rem 0;
        position: relative;
    }

    .prose pre code {
        background: none;
        border: none;
        padding: 0;
        font-size: 0.9rem;
        color: var(--text-secondary);
    }

    .prose blockquote {
        border-left: 3px solid var(--accent-color);
        margin: 1.5rem 0;
        padding: 0.75rem 1.25rem;
        background: rgba(168, 85, 247, 0.06);
        border-radius: 0 10px 10px 0;
    }

    .prose blockquote p {
        margin: 0;
        color: var(--text-secondary);
        font-style: italic;
    }

    .prose ul, .prose ol {
        color: var(--text-secondary);
        padding-left: 1.5rem;
        margin-bottom: 1.25rem;
        line-height: 1.85;
    }

    .prose li {
        margin-bottom: 0.4rem;
    }

    .prose ul li::marker {
        color: var(--accent-color);
    }

    .prose hr {
        border: none;
        border-top: 1px solid var(--border-color);
        margin: 2rem 0;
    }

    .prose img {
        border-radius: 12px;
        max-width: 100%;
        border: 1px solid var(--border-color);
    }

    .prose table {
        width: 100%;
        border-collapse: collapse;
        margin: 1.5rem 0;
        font-size: 0.95rem;
    }

    .prose th {
        text-align: left;
        padding: 0.6rem 1rem;
        color: var(--text-primary);
        font-weight: 600;
        border-bottom: 1px solid var(--border-hover);
        background: rgba(168, 85, 247, 0.05);
    }

    .prose td {
        padding: 0.6rem 1rem;
        color: var(--text-secondary);
        border-bottom: 1px solid var(--border-color);
    }

    .prose tr:last-child td {
        border-bottom: none;
    }
    </style>

<style>
    /* ── Layout ── */
    .page-wrapper {
        display: grid;
        grid-template-columns: 260px minmax(0, 740px);
        justify-content: center;
        gap: 3.5rem;
        max-width: 1200px;
        margin: 0 auto;
        padding: 5rem 2rem 8rem;
        position: relative;
        z-index: 1;
        font-family: var(--font-sans);
    }

    /* ── Ambient glows ── */
    .ambient-glow {
        position: fixed;
        inset: 0;
        background: var(--bg-glow);
        z-index: -2;
        pointer-events: none;
    }

    .ambient-glow-secondary {
        position: fixed;
        inset: 0;
        background: radial-gradient(ellipse 55% 45% at 100% 100%, rgba(45, 212, 191, 0.12) 0%, transparent 100%);
        z-index: -2;
        pointer-events: none;
    }

    .noise-overlay {
        position: fixed;
        inset: 0;
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");
        opacity: 0.025;
        z-index: -1;
        pointer-events: none;
    }

    /* ── TOC Sidebar ── */
    .toc-sidebar {
        position: sticky;
        top: 5rem;
        max-height: calc(100vh - 7rem);
        overflow-y: auto;
        scrollbar-width: none;
    }

    .toc-sidebar::-webkit-scrollbar { display: none; }

    .toc-inner {
        padding: 1.25rem 1.25rem 1.5rem;
        border-radius: 18px;
        background: rgba(14, 10, 31, 0.6);
        border: 1px solid var(--border-color);
        backdrop-filter: blur(24px);
        -webkit-backdrop-filter: blur(24px);
        box-shadow:
            0 0 0 1px rgba(168, 85, 247, 0.06),
            0 24px 48px rgba(0, 0, 0, 0.4),
            inset 0 1px 0 rgba(255, 255, 255, 0.04);
    }

    .toc-label {
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--text-primary);
        margin-bottom: 1rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .toc-label svg {
        color: var(--accent-color);
        flex-shrink: 0;
    }

    #toc-nav {
        list-style: none;
        margin: 0;
        padding: 0;
        color: var(--text-secondary);
        font-weight: 600;
    }

    /* ── Article ── */
    .post-container {
        min-width: 0;
        animation: fadeUp 0.5s ease both;
    }

    @keyframes fadeUp {
        from { opacity: 0; transform: translateY(16px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    /* ── Header ── */
    .post-header {
        margin-bottom: 2rem;
    }

    .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-bottom: 1.25rem;
    }

    .tag {
        display: inline-flex;
        align-items: center;
        font-size: 0.72rem;
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        padding: 0.3rem 0.75rem;
        border-radius: 100px;
        text-decoration: none;
        background: rgba(168, 85, 247, 0.1);
        color: var(--accent-light);
        border: 1px solid rgba(168, 85, 247, 0.25);
        transition: background 0.2s, border-color 0.2s, transform 0.15s;
    }

    .tag:hover {
        background: rgba(168, 85, 247, 0.18);
        border-color: rgba(168, 85, 247, 0.5);
        transform: translateY(-1px);
    }

    .post-title {
        font-size: clamp(1.75rem, 4vw, 2.6rem);
        font-weight: 800;
        line-height: 1.2;
        letter-spacing: -0.03em;
        color: var(--text-primary);
        margin: 0 0 1rem;
        /* Gradient text effect */
        background: linear-gradient(135deg, var(--text-primary) 30%, var(--accent-light) 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .post-description {
        font-size: 1.1rem;
        line-height: 1.7;
        color: var(--text-secondary);
        margin: 0 0 1.5rem;
        max-width: 68ch;
    }

    .meta {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.5rem 0;
        font-size: 0.82rem;
        color: var(--text-muted);
    }

    .meta-author,
    .meta-date,
    .meta-updated {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
    }

    .meta-icon-wrap {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 22px;
        height: 22px;
        border-radius: 6px;
        background: rgba(168, 85, 247, 0.1);
        color: var(--accent-color);
        flex-shrink: 0;
    }

    .meta-dot {
        width: 3px;
        height: 3px;
        border-radius: 50%;
        background: var(--border-hover);
        margin: 0 0.4rem;
        display: inline-block;
    }

    /* ── Divider ── */
    .divider {
        height: 1px;
        background: linear-gradient(to right, transparent, var(--border-hover), transparent);
        margin: 2rem 0 2.5rem;
        position: relative;
    }

    .divider::after {
        content: '';
        position: absolute;
        left: 50%;
        top: 50%;
        transform: translate(-50%, -50%);
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--accent-color);
        box-shadow: 0 0 12px var(--accent-glow);
    }

    /* ── Back to top ── */
    .back-to-top-wrap {
        display: flex;
        justify-content: center;
        padding: 3rem 0 1rem;
    }

    .back-to-top {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.82rem;
        font-weight: 500;
        color: var(--text-muted);
        background: none;
        border: 1px solid var(--border-color);
        border-radius: 100px;
        padding: 0.5rem 1.1rem;
        cursor: pointer;
        font-family: var(--font-sans);
        transition: color 0.2s, border-color 0.2s, background 0.2s, transform 0.15s;
    }

    .back-to-top:hover {
        color: var(--accent-light);
        border-color: rgba(168, 85, 247, 0.4);
        background: rgba(168, 85, 247, 0.07);
        transform: translateY(-2px);
    }

    /* ── Responsive ── */
    @media (max-width: 900px) {
        .page-wrapper {
            grid-template-columns: minmax(0, 740px);
            padding: 3rem 1.25rem 6rem;
        }

        .toc-sidebar {
            display: none;
        }
    }
</style>

<!-- Reading progress bar injected at the top of body -->
<div id="reading-progress" aria-hidden="true"></div>


